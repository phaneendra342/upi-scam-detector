# ============================================================================
# UPI / QR Payment Scam & Phishing Detector - Environment Configuration
# ============================================================================
# INSTRUCTIONS:
# 1. To use optional external threat intelligence (like Google Safe Browsing),
#    copy this file and rename the copy to: .env
# 2. Paste your API key below inside your local .env file.
# 3. NEVER commit your real .env file to GitHub!
# ============================================================================

# Optional: Google Safe Browsing API v4 Key
# Leave blank to run in 100% offline/local heuristic analysis mode.
GOOGLE_SAFE_BROWSING_API_KEY=

# Application Privacy & Upload Settings
MAX_UPLOAD_SIZE_MB=5
ENABLE_LOCAL_HISTORY=true